# Copy this file to .env. Never commit .env or real credentials.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
SIGNING_MASTER_KEY=replace-with-a-long-random-signing-key
PII_ENCRYPTION_KEY=replace-with-a-different-long-random-pii-key
DATABASE_URL=sqlite:///./onecare.db
ACCESS_TOKEN_TTL_SECONDS=3600
SELF_REGISTRATION_ENABLED=true
AUTO_CREATE_SCHEMA=true
SEED_DEMO_ADMIN=false
DEMO_ADMIN_EMAIL=admin@onecareloop.com
DEMO_ADMIN_PASSWORD=replace-this-demo-password
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Local Docker Compose only; use a secrets manager in production.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Public challenge judge demo. Keep disabled outside the synthetic demo environment.
DEMO_MODE_ENABLED=false
DEMO_SHOW_CREDENTIALS=false
DEMO_PHARMACY_EMAIL=demo.pharmacy@onecareloop.com
DEMO_PHARMACY_PASSWORD=replace-with-a-unique-demo-password-min-12-chars
DEMO_HOSPITAL_EMAIL=demo.hospital@onecareloop.com
DEMO_HOSPITAL_PASSWORD=use-a-different-demo-password-min-12-chars
DEMO_CLINICIAN_EMAIL=demo.clinician@onecareloop.com
DEMO_CLINICIAN_PASSWORD=another-distinct-demo-password-min-12
DEMO_HMO_EMAIL=demo.hmo@onecareloop.com
DEMO_HMO_PASSWORD=one-more-unique-demo-password-min-12-chars
