# LOCAL SYNTHETIC JUDGE DEMO ONLY — replace every placeholder before use.
# Never use this configuration with real patient information or production data.
APP_ENV=development
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SIGNING_MASTER_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS
PII_ENCRYPTION_KEY=REPLACE_WITH_A_THIRD_DISTINCT_RANDOM_PII_KEY_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./onecare-judge-demo.db
ACCESS_TOKEN_TTL_SECONDS=3600
SELF_REGISTRATION_ENABLED=false
AUTO_CREATE_SCHEMA=true
SEED_DEMO_ADMIN=false
DEMO_MODE_ENABLED=true
DEMO_SHOW_CREDENTIALS=true
DEMO_PHARMACY_EMAIL=demo.pharmacy@onecareloop.com
DEMO_PHARMACY_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_PHARMACY_PASSWORD
DEMO_HOSPITAL_EMAIL=demo.hospital@onecareloop.com
DEMO_HOSPITAL_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_HOSPITAL_PASSWORD
DEMO_CLINICIAN_EMAIL=demo.clinician@onecareloop.com
DEMO_CLINICIAN_PASSWORD=CHANGE_THIS_TO_A_DISTINCT_CLINICIAN_PASSWORD
DEMO_HMO_EMAIL=demo.hmo@onecareloop.com
DEMO_HMO_PASSWORD=CHANGE_THIS_TO_A_SEPARATE_HMO_REVIEWER_PASSWORD
CORS_ORIGINS=[]
